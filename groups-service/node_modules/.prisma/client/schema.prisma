generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum group_level {
  beginner
  intermediate
  advanced
  expert
}

enum group_member_role {
  owner
  admin
  member
}

// ─── Existing tables referenced by FK (owned by user-service) ────────────────
// We include `users` only to let Prisma resolve FK constraints on GroupMember.
// No relations from GroupMember → users are declared; user_id is a plain UUID.

// ─── Groups-service tables ────────────────────────────────────────────────────

model GroupCategory {
  id    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  String  @db.VarChar(100)
  color String? @db.VarChar(20)

  groups Group[]

  @@map("group_categories")
}

model Group {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String      @db.VarChar(150)
  description String?     @db.Text
  category_id String?     @db.Uuid
  level       group_level @default(beginner)
  is_active   Boolean     @default(true)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime    @updatedAt @db.Timestamptz(6)

  category GroupCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  members  GroupMember[]

  @@index([category_id])
  @@index([level])
  @@index([is_active])
  @@map("groups")
}

model GroupMember {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id  String            @db.Uuid
  user_id   String            @db.Uuid
  role      group_member_role @default(member)
  joined_at DateTime          @default(now()) @db.Timestamptz(6)

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([group_id, user_id])
  @@index([user_id])
  @@map("group_members")
}
