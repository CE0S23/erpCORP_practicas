# ─── Tickets Service — Environment Variables ──────────────────────────────────

# Server
PORT=3003
NODE_ENV=development

# Neon PostgreSQL (add ?sslmode=require for Neon)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Shared secret sent by the API Gateway in every internal request
INTERNAL_SECRET=secret_compartido_con_gateway
