generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum AppRole {
  superAdmin
  admin
  medium
  user

  @@map("app_role")
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique @db.VarChar(255)
  name         String     @db.VarChar(150)
  /// Bcrypt hash of the user's password. Never returned in API responses.
  passwordHash String?    @map("password_hash")
  avatarUrl    String?    @map("avatar_url")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  /// Automatically updated by Prisma on every write.
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  userRoles    UserRole[]
  userPermissions UserPermission[]

  @@map("users")
}

model Role {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           AppRole          @unique
  label          String           @db.VarChar(100)
  hierarchyLevel Int              @map("hierarchy_level")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String  @unique @db.VarChar(100)
  description String?

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  userId       String @map("user_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

// ─── Logs & Metrics ──────────────────────────────────────────────────────────

model Log {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp  DateTime @default(now()) @db.Timestamptz
  endpoint   String
  method     String   @db.VarChar(10)
  userId     String?  @map("user_id")
  ip         String   @db.VarChar(45)
  statusCode Int      @map("status_code")
  service    String   @db.VarChar(50)
  errorStack String?  @map("error_stack") @db.Text

  @@map("logs")
}

model Metric {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  endpoint           String
  method             String   @db.VarChar(10)
  requestCount       Int      @default(1) @map("request_count")
  totalResponseTimeMs BigInt  @default(0) @map("total_response_time_ms")
  avgResponseTimeMs  Float    @default(0) @map("avg_response_time_ms")
  lastUpdated        DateTime @default(now()) @updatedAt @map("last_updated") @db.Timestamptz

  @@unique([endpoint, method])
  @@map("metrics")
}
